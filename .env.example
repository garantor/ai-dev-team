# Environment Variables for Uniswap DEX App

# Ethereum Network Configuration
# Options: mainnet, goerli, sepolia
VITE_NETWORK=mainnet

# Infura or Alchemy API Key (optional - for RPC provider)
# Get your API key from: https://infura.io or https://www.alchemy.com
VITE_INFURA_KEY=your_infura_key_here

# WalletConnect Project ID (optional - for WalletConnect support)
# Get your project ID from: https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Enable debug mode
VITE_DEBUG=false
