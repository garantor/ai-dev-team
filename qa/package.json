  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.45.3",
    "@types/node": "^20.14.12",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "faker": "^5.5.3",
    "vitest": "^2.0.4"
  }
}
