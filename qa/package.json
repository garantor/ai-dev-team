{
  "name": "qa-tests",
  "version": "1.0.0",
  "description": "QA tests for the fitness application",
  "main": "index.js",
  "scripts": {
    "test:unit": "vitest run --dir qa/unit",
    "test:integration": "vitest run --dir qa/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.44.1",
    "@vitest/coverage-v8": "^1.6.0",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "vitest": "^1.6.0"
  }
}